{
  "name": "wwp-monitor",
  "private": true,
  "version": "1.0.0",
  "description": "Websites With Punch background uptime checker (Cloudflare Worker, free plan).",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute wwp-monitor --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute wwp-monitor --local --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.160.0"
  }
}
