generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                  @id @default(cuid())
  name                  String?
  email                 String                  @unique
  password              String
  /// When the address was confirmed with an emailed code (see lib/email-verify.ts). Accounts
  /// created before VERIFICATION_STARTED_AT count as verified even while this is null.
  emailVerified         DateTime?
  image                 String?
  plan                  String                  @default("free") // free | pro | business (paid-through)
  sitePackCount         Int                     @default(0)
  /// Target pack count after a scheduled removal (applies at pendingPackChangeAt).
  pendingSitePackCount  Int?
  /// When pendingSitePackCount becomes the live limit (usually next renewal).
  pendingPackChangeAt   DateTime?
  /// Target plan after a scheduled downgrade/cancel (applies at pendingPlanAt).
  pendingPlan           String?
  /// When pendingPlan becomes live (usually next renewal / cancel date).
  pendingPlanAt         DateTime?
  /// Mirrors Dodo cancel_at_next_billing_date for dashboard UI.
  cancelAtPeriodEnd     Boolean                 @default(false)
  /// Unused (was 24h active-site swap cooldown). Kept to avoid schema churn.
  lastSiteSwapAt        DateTime?
  /// Show the "we kept your oldest" banner until dismissed.
  showDefaultLockNotice Boolean                 @default(false)
  /// Dodo Payments customer (cus_…), created before the first checkout.
  dodoCustomerId        String?                 @unique
  /// Current Dodo subscription (sub_…): one per customer, packs are add-ons on it.
  dodoSubscriptionId    String?                 @unique
  dodoStatus            String? // active | past_due | on_hold | cancelled | expired | failed
  /// Timestamp of the newest webhook applied (older, out-of-order events are skipped).
  dodoSyncedAt          DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  accounts              Account[]
  sessions              Session[]
  sites                 Site[]
  contactMessages       ContactMessage[]
  passwordResetTokens   PasswordResetToken[]
  emailCodes            EmailVerificationCode[]
  /// Email alert preferences (on by default; one-click unsubscribe turns one off).
  alertDown             Boolean                 @default(true)
  alertSsl              Boolean                 @default(true)
  alertDomain           Boolean                 @default(true)
  alertLogs             AlertLog[]
  /// Referral program (lib/referrals). Code is created on first visit to /referrals.
  referralCode          String?                 @unique
  referredById          String?
  referredBy            User?                   @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             User[]                  @relation("Referrals")
  referredAt            DateTime?
  /// Visits to /r/CODE that set a new attribution cookie (rough count, not unique people).
  referralClicks        Int                     @default(0)
  /// SHA-256 of the signup IP (salted), only to refuse obvious self-referrals.
  signupIpHash          String?
  payoutMethod          String? // paypal | upi
  payoutAddress         String?
  payoutUpdatedAt       DateTime?
  commissionsEarned     Commission[]            @relation("Earned")
  commissionsPaidFor    Commission[]            @relation("Payer")
  payouts               Payout[]
  heartbeats            Heartbeat[]
  /// Weekly email report (opt-in). Sent on the user's weekday bucket (lib/reports), at most once in 6 days.
  weeklyReport          Boolean                 @default(false)
  weeklyReportSentAt    DateTime?
  /// Getting-started checklist on the dashboard overview was dismissed.
  onboardingDismissedAt DateTime?
  alertChannels         AlertChannel[]
  statusPages           StatusPage[]
  /// Admin insights (lib/activity). Written only at login and when a new browser session opens
  /// the dashboard, never per request. Location is coarse (country/region/city from Vercel's
  /// IP geo headers); the IP itself is not stored.
  lastLoginAt           DateTime?
  lastActiveAt          DateTime?
  lastCountry           String?
  lastRegion            String?
  lastCity              String?
  /// Coarse device class + browser, e.g. "Desktop · Chrome".
  lastDevice            String?
  signupCountry         String?
  signupCity            String?
  /// First-touch source: external referrer host, "direct", or the utm_source.
  signupSource          String?
  /// First-touch UTM + landing path: { source, medium, campaign, landing }.
  signupUtm             Json?
  activity              UserActivity[]

  @@index([emailVerified, createdAt])
  @@index([referredById])
  @@index([lastActiveAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Site {
  id              String        @id @default(cuid())
  userId          String
  name            String
  url             String
  status          String        @default("pending") // up | down | pending | error
  lastCheckedAt   DateTime?
  lastStatusCode  Int?
  lastLatencyMs   Int?
  sslExpiresAt    DateTime?
  sslDaysLeft     Int?
  domainExpiresAt DateTime?
  domainDaysLeft  Int?
  /// Full certificate facts from the last check (issuer, SANs, validity, TLS…); see lib/site-info.ts.
  sslInfo         Json?
  /// Registrar, dates, nameservers, status codes and source from the last domain lookup.
  domainInfo      Json?
  /// Not monitored; metrics hidden from client until unlocked.
  locked          Boolean       @default(false)
  lockedAt        DateTime?
  /// Marked to stay active when a pending limit reduction applies.
  keepOnDowngrade Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults    CheckResult[]
  /// Set when a "site down" alert went out; cleared (with a recovery email) when it's back up.
  alertDownAt     DateTime?
  alertLogs       AlertLog[]

  @@unique([userId, url])
  @@index([userId])
  @@index([userId, locked])
  /// Cron: unlocked sites, least recently checked first.
  @@index([locked, lastCheckedAt])
}

model CheckResult {
  id         String   @id @default(cuid())
  siteId     String
  status     String // up | down | error
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime @default(now())
  /// Monitor roll-ups: how many checks this row stands for and how many failed (null = one check).
  samples    Int?
  failures   Int?
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, checkedAt])
  /// Daily retention prune (delete rows older than the longest analytics range).
  @@index([checkedAt])
}

/// Contact form submissions (backup copy; the team is also emailed via Resend).
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  topic     String // general | billing | custom-limits | other
  message   String
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  emailSent Boolean   @default(false)
  /// Admin marked it handled (null = open).
  handledAt DateTime?
  handledBy String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

/// Password reset links. Only a SHA-256 hash of the token is stored; tokens are single-use and expire after 1 hour.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Fixed-window rate limit counters shared by every serverless instance. One row per key
/// (e.g. "login:ip:1.2.3.4"); expired rows are reset in place and pruned by the daily cron.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Dodo webhook deliveries already handled, keyed by the webhook-id header (idempotency:
/// Dodo retries failed deliveries and may deliver twice). Pruned after 30 days by the cron.
model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 6-digit email verification codes: HMAC-hashed, 10-minute expiry, single use, max 5 tries.
/// Issuing a new code deletes the user's older ones.
model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// One row per alert email (dedupe): key is e.g. "ssl:7:2026-11-02" or "down:<iso>". The unique
/// (siteId, key) makes every threshold or incident send at most once, even with parallel checks.
model AlertLog {
  id        String   @id @default(cuid())
  userId    String
  siteId    String
  key       String
  kind      String // down | recovered | ssl | domain
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, key])
  @@index([userId, createdAt])
}

/// Referral ledger: one row per paid Dodo payment by a referred user (paymentId unique = idempotent).
/// pending (30-day hold) -> available -> requested -> paid; reversed on refund/dispute.
model Commission {
  id               String    @id @default(cuid())
  referrerId       String
  referredUserId   String?
  paymentId        String    @unique
  subscriptionId   String?
  currency         String
  /// Amount the commission is based on (payment total minus tax), smallest unit.
  baseCents        Int
  rateBps          Int
  amountCents      Int
  status           String // pending | available | requested | paid | reversed
  availableAt      DateTime
  payoutId         String?
  /// Reversed after it was paid out: owed back, offset against the next payout.
  clawback         Boolean   @default(false)
  clawbackPayoutId String?
  reversedReason   String? // refund | dispute
  reversedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  referrer         User      @relation("Earned", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUser     User?     @relation("Payer", fields: [referredUserId], references: [id], onDelete: SetNull)
  payout           Payout?   @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([referrerId, status])
  @@index([status, availableAt])
  @@index([payoutId])
}

/// Manual withdrawal requests (PayPal or UPI). Method/address are snapshotted at request time.
model Payout {
  id              String       @id @default(cuid())
  userId          String
  amountCents     Int
  currency        String       @default("USD")
  method          String
  address         String
  status          String       @default("requested") // requested | paid | rejected
  reference       String?
  reason          String?
  decidedBy       String?
  decidedAt       DateTime?
  /// Amount at the moment of the request (amountCents can drop if a commission is reversed before payment).
  requestedCents  Int?
  /// Set when a refund/dispute changed amountCents while the request was open.
  amountChangedAt DateTime?
  /// UPI payouts: the INR actually sent, in paise (entered by the admin when marking paid).
  paidInrPaise    Int?
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions     Commission[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Security-relevant actions (payout method changes, withdrawals, admin decisions).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

/// Per-admin "last looked at" time for each admin section/filter (green "new" badges).
/// prevAt keeps the visit before, so a refresh right after opening still highlights new rows.
model AdminSeen {
  id         String    @id @default(cuid())
  adminEmail String
  key        String
  seenAt     DateTime
  prevAt     DateTime?

  @@unique([adminEmail, key])
}

/// Heartbeat (cron job) monitor: the job calls its secret ping URL, which is answered by the
/// monitor Worker (D1), never by this database. The Worker reports missed pings and recoveries.
model Heartbeat {
  id          String           @id @default(cuid())
  userId      String
  name        String
  /// Secret part of the ping URL (random, URL-safe).
  token       String           @unique
  /// Expected time between pings, and extra time allowed before it counts as missed.
  periodSec   Int
  graceSec    Int
  paused      Boolean          @default(false)
  status      String           @default("new") // new | up | down
  lastPingAt  DateTime?
  /// Set when a "missed" alert went out; cleared (with a recovery email) when pings resume.
  alertDownAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      HeartbeatEvent[]
  days        HeartbeatDay[]

  @@index([userId])
}

/// Missed / resumed history (90 days). key is unique per heartbeat, so each email sends once.
model HeartbeatEvent {
  id          String    @id @default(cuid())
  heartbeatId String
  kind        String // down | up
  key         String
  at          DateTime
  lastPingAt  DateTime?
  sent        Boolean   @default(false)
  heartbeat   Heartbeat @relation(fields: [heartbeatId], references: [id], onDelete: Cascade)

  @@unique([heartbeatId, key])
  @@index([heartbeatId, at])
  @@index([at])
}

/// Pings recorded per heartbeat per UTC day (90 days), sent by the Worker once an hour.
model HeartbeatDay {
  heartbeatId String
  day         DateTime  @db.Date
  pings       Int       @default(0)
  heartbeat   Heartbeat @relation(fields: [heartbeatId], references: [id], onDelete: Cascade)

  @@id([heartbeatId, day])
  @@index([day])
}

/// Slack / Discord / Telegram / generic webhook alert destination. config is AES-256-GCM encrypted
/// JSON (lib/channels/secret-box.ts): webhook URL, or Telegram bot token + chat id, plus the webhook
/// signing secret. Only a short, non-secret hint is stored in clear text for the list.
model AlertChannel {
  id         String    @id @default(cuid())
  userId     String
  kind       String // slack | discord | telegram | webhook
  name       String
  config     String
  hint       String
  /// Events this channel receives: down, recovered, ssl, domain, heartbeat.
  events     String[]
  /// true = every site; false = only siteIds (ownership re-checked when sending).
  allSites   Boolean   @default(true)
  siteIds    String[]
  enabled    Boolean   @default(true)
  lastSentAt DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Public status page at /status/[slug] showing the chosen sites (ISR-cached, 60 s).
model StatusPage {
  id          String   @id @default(cuid())
  userId      String
  slug        String   @unique
  title       String
  description String?
  siteIds     String[]
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Sign-up, login and session-start events for the admin timeline (pruned after 180 days).
model UserActivity {
  id      String   @id @default(cuid())
  userId  String
  kind    String // signup | login | session
  country String?
  city    String?
  device  String?
  at      DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([at])
}

/// Last run of each scheduled job / Worker sync, for the admin System health page.
model JobRun {
  key   String   @id // cron:check | cron:reports | worker:sites | worker:ingest | worker:heartbeats
  at    DateTime
  ok    Boolean  @default(true)
  ms    Int?
  note  String?
  runs  Int      @default(1)
}
