# Database: PostgreSQL (e.g. Neon). Copy the connection string from Neon → Connect.
# The pooled string (host contains "-pooler") works for the app and for `npx prisma db push`.
# Keep ?sslmode=require. If Neon was asleep and the first command times out, run it again
# or add &connect_timeout=15.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Cron protection — send as Authorization: Bearer <secret> or x-cron-secret.
# Generate a different value with the same command:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET="generate-another-secret"

# Fast checks (Cloudflare Worker in workers/monitor). Off unless set to "1"; needs a redeploy.
# While off, the site says "checked once a day" and the monitor endpoints return nothing.
NEXT_PUBLIC_FAST_CHECKS="0"
# Shared with the Worker (npx wrangler secret put MONITOR_SECRET). 24+ characters.
MONITOR_SECRET="generate-a-third-secret"
# Optional: the Worker URL, so new sites start being checked within a minute.
MONITOR_WORKER_URL=""

# One-off / test user seed — POST /api/dev/seed-test-users with header x-seed-key
# Falls back to NEXTAUTH_SECRET if unset
SEED_SECRET="generate-a-seed-secret"

# Optional warn thresholds (days)
SSL_WARN_DAYS="30"
DOMAIN_WARN_DAYS="30"

# Dodo Payments (merchant of record). Optional for a local demo: without a key the Upgrade
# buttons still show and checkout answers with a clear "billing unavailable" message.
# Build in TEST MODE first, then switch all values below to their live-mode versions.
# Dashboard → Developer → API Keys (test and live keys are separate).
DODO_PAYMENTS_API_KEY="..."
# Dashboard → Developer → Webhooks → your endpoint → Overview → signing secret (whsec_...).
# Endpoint URL: https://www.websiteswithpunch.com/api/webhooks/dodo
DODO_PAYMENTS_WEBHOOK_KEY="whsec_..."
# test_mode (https://test.dodopayments.com) or live_mode (https://live.dodopayments.com)
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# Subscription products (Dashboard → Products). Each plan × interval is its own product.
# Products and IDs differ between test and live mode: recreate them in live mode at launch.
# Annual = 10 × monthly. Trial days are set ON THE PRODUCT (Starter only: 30); the app never
# passes trial_period_days, so Dodo's "Prevent Trial Misuse" stays in force.
# Starter: 10 sites, $5/month and $50/year, 30-day trial on both products
DODO_PRODUCT_STARTER_MONTHLY="pdt_..."
DODO_PRODUCT_STARTER_ANNUAL="pdt_..."
# Pro: 30 sites, $12/month and $120/year (the existing Pro products can be kept)
DODO_PRODUCT_PRO_MONTHLY="pdt_..."
DODO_PRODUCT_PRO_ANNUAL="pdt_..."
# Business: 100 sites, $24/month and $240/year (NEW products; the old $42/$420 ones go below)
DODO_PRODUCT_BUSINESS_MONTHLY="pdt_..."
DODO_PRODUCT_BUSINESS_ANNUAL="pdt_..."

# Custom = Business + the "Extra 25 sites" add-on (quantity 1–16 → 125–500 sites). An add-on
# bills on its parent's cycle, so it exists twice: $5/month (attach to Business Monthly only)
# and $50/year (attach to Business Annual only).
DODO_ADDON_EXTRA25_MONTHLY="adn_..."
DODO_ADDON_EXTRA25_ANNUAL="adn_..."

# Leave unset: every customer pays in USD (production decision). Setting it to 1 would let plain
# Starter/Pro/Business checkouts use Dodo INR prices (Custom stays USD); see DODO_SETUP.md.
# DODO_LOCALIZED_PRICING="1"

# Legacy IDs, recognised for existing subscribers until their renewal; never sold again.
# Old Business ($42/$420, 50 sites):
DODO_PRODUCT_BUSINESS_LEGACY_MONTHLY="pdt_..."
DODO_PRODUCT_BUSINESS_LEGACY_ANNUAL="pdt_..."
# Old site packs (detach from all products in Dodo; keep the IDs here):
DODO_ADDON_PACK_PRO_MONTHLY="adn_..."
DODO_ADDON_PACK_PRO_ANNUAL="adn_..."
DODO_ADDON_PACK_BUSINESS_MONTHLY="adn_..."
DODO_ADDON_PACK_BUSINESS_ANNUAL="adn_..."

# Worker capacity guard for Custom sizes (sites checked per minute the Worker can handle).
# Defaults to 600; raise it if the Worker's batch size or fan-out grows.
# WORKER_SITES_PER_MINUTE="600"

# Contact form (/contact). Messages are always saved to the ContactMessage table; when
# RESEND_API_KEY is set they are also emailed to the team via the Resend HTTP API.
# Without a key (e.g. local dev) the message is logged to the server console instead.
# Create a key at https://resend.com/api-keys after verifying your sending domain.
RESEND_API_KEY="re_..."
# Sender: must be on a domain verified in Resend. Default shown.
CONTACT_FROM_EMAIL="Websites With Punch <contact@websiteswithpunch.com>"
# Where contact messages are delivered (the visitor's email is set as Reply-To). Default shown.
CONTACT_TO_EMAIL="hello@websiteswithpunch.com"

# Password reset emails (/forgot-password) use the same RESEND_API_KEY. Links point at
# NEXTAUTH_URL/reset-password and expire after 1 hour. Without a key, dev logs the link to the
# server console. Optional sender for auth email; defaults to CONTACT_FROM_EMAIL.
# AUTH_FROM_EMAIL="Websites With Punch <hello@websiteswithpunch.com>"
